<?php


namespace app\{{module}}\dependency;


use app\common\dependency\Dependency;

use app\{{module}}\service\{{class}}Service;
use app\{{module}}\validate\{{class}}Validate;
use app\{{module}}\repository\{{class}}Repository;

class {{class}}Dependency
{
    /**
     * 获取存储类
     * @return {{class}}Repository
     */
    public static function getRepository()
    {
        return Dependency::getProxy({{class}}Repository::class);
    }

    /**
     * 获取服务类
     * @return {{class}}Service
     */
    public static function getService()
    {
        return Dependency::getProxy({{class}}Service::class);
    }

    /**
     * 获取验证器
     * @return {{class}}Validate
     */
    public static function getValidate()
    {
        return Dependency::getProxy({{class}}Validate::class);
    }
}