<?php


namespace app\{{module}}\service;


use Exception;

use app\common\service\Service;
use app\common\repository\Wrapper;

use app\{{module}}\repository\{{class}}Repository;

class {{class}}Service extends Service
{
    /**
     * {{comment}}存储类
     * @var {{class}}Repository
     */
    protected {{class}}Repository ${{class}}Repository;

    /**
     * 获取列表
     * @throws Exception
     */
    public function list{{class}}(array $params)
    {
        $Wrapper = new Wrapper();

        if (!empty($params['{{tableId}}'])) {
            $Wrapper->addWhere('{{tableId}}', '=', $params['{{tableId}}']);
        }

        if (!empty($params['name'])) {
            $Wrapper->addWhere('name', 'like', "%{$params['name']}%");
        }

        $Wrapper->setPage($params['page']);
        $Wrapper->setLimit($params['limit']);

        $Wrapper->addOrder('sort', 'asc');

        $list  = $this->{{class}}Repository->getList($Wrapper);
        $total = $this->{{class}}Repository->getTotal($Wrapper);

        return ['list' => $list, 'total' => $total];
    }

    /**
     * ID查询
     * @param ${{tableId}}
     * @return array
     * @throws Exception
     */
    public function getBy{{class}}Id(${{tableId}})
    {
        return $this->{{class}}Repository->getById(${{tableId}});
    }

    /**
     * 添加
     * @param array $params
     * @return int
     */
    public function create{{class}}(array $params)
    {
        return $this->{{class}}Repository->createRecord($params);
    }

    /**
     * 修改
     * @param array $params
     * @return int
     * @throws Exception
     */
    public function update{{class}}(array $params)
    {
        return $this->{{class}}Repository->updateById($params['{{tableId}}'], $params);
    }

    /**
     * 删除
     * @param array $params
     * @return int
     * @throws Exception
     */
    public function delete{{class}}(array $params)
    {
        return $this->{{class}}Repository->deleteById($params['{{tableId}}']);
    }
}